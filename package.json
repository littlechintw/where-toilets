{
  "name": "where-toilet",
  "version": "1.0.0",
  "description": "Taiwan Toilet Map — find the nearest public toilet across Taiwan",
  "homepage": "https://toilets.littlechin.tw",
  "repository": {
    "type": "git",
    "url": "https://github.com/littlechin/where-toilets"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/build-icon-font.mjs",
    "fetch-data": "node scripts/fetch-toilets.js",
    "normalize-data": "node scripts/normalize-data.js",
    "process-data": "npm run fetch-data && npm run normalize-data",
    "clean-data": "rm -rf public/data/counties/*.json public/data/raw-toilets.json public/data/deploy-flag.json",
    "check-deploy-flag": "test -f public/data/deploy-flag.json && echo 'Deploy flag exists' || echo 'No deploy flag'"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "node-fetch": "^3.3.2",
    "vite": "^7.3.7"
  },
  "keywords": [
    "toilet",
    "map",
    "taiwan",
    "vue",
    "public-service"
  ],
  "author": "littlechin.tw (https://littlechin.tw)",
  "license": "SEE LICENSE IN LICENSE"
}
